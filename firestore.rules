rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && (resource == null || request.auth.uid == resource.data.uid);
    }

    // 1. users: Allow public read and registration; write if owner
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isOwner(userId);
    }

    // 2. donors: Public read for matching; write if authenticated owner
    match /donors/{donorId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isOwner(donorId) || isDocOwner();
    }

    // 3. receivers
    match /receivers/{receiverId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 4. bloodBanks: Public read; write if authenticated owner
    match /bloodBanks/{bankId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isOwner(bankId) || isDocOwner();
    }

    // 5. bloodInventory: Public read; write if authenticated
    match /bloodInventory/{inventoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 6. bloodRequests: Public read; create and update if authenticated
    match /bloodRequests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 7. dispatches
    match /dispatches/{dispatchId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 8. notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 9. donations
    match /donations/{donationId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 10. contractDonors
    match /contractDonors/{donorId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 11. ngoPartners
    match /ngoPartners/{partnerId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 12. bloodCollectionCamps
    match /bloodCollectionCamps/{campId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 13. bloodBankStaff
    match /bloodBankStaff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 14. activityLogs: Write for audit trail
    match /activityLogs/{logId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }

    // 15. reports
    match /reports/{reportId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 16. settings
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 17. moneyDonations
    match /moneyDonations/{donationId} {
      allow read, create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}

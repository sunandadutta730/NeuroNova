# ===== LifeLink .gitignore =====

# Firebase configuration with sensitive API key override
config/firebase-config.js
firebase-config.js

# Dependencies
node_modules/
package-lock.json

# Environment overrides & local secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.share
.env*.local

# Firebase CLI cache & debug logs
.firebase/
*-debug.log
.firestore/
firebase-debug.log
firestore-debug.log
ui-debug.log

# OS system files
.DS_Store
Thumbs.db

# IDE & Editor directories
.vscode/
.idea/

# Temporary files & logs
*.log
*.tmp
